{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#CC7832"
    },
    "padding": {
      "top": 1,
      "right": 5
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "#CC7832",
      "title": "#E8E8E8",
      "output": "#A9B7C6",
      "separator": "#4E5254"
    },
    "key": {
      "width": 19
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "━",
        "total": "─"
      }
    },
    "showErrors": false
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇  Sistema"
    },
    {
      "type": "host",
      "key": "󰌢  Equipo"
    },
    {
      "type": "kernel",
      "key": "󰒋  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰥔  Tiempo"
    },
    {
      "type": "packages",
      "key": "󰏗  Paquetes"
    },
    "break",
    {
      "type": "wm",
      "key": "󰖲  Ventanas"
    },
    {
      "type": "terminal",
      "key": "󰆍  Terminal"
    },
    {
      "type": "shell",
      "key": "󱆃  Shell"
    },
    {
      "type": "display",
      "key": "󰍹  Pantalla"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠  CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛  Memoria",
      "percent": {
        "type": 3,
        "green": 40,
        "yellow": 75
      }
    },
    {
      "type": "disk",
      "key": "󰋊  Disco",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
