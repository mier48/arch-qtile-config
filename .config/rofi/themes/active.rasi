/* Qtile Obsidian — Rofi palette and centered search surface. */
* {
    background:     #111820;
    surface:        #18232E;
    surface-hover:  #233341;
    border:         #35434F;
    text:           #C9D6E1;
    text-strong:    #EDF3F8;
    muted:          #778895;
    accent:         #82CDBE;
    urgent:         #E78991;

    background-color: transparent;
    text-color: @text;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 720px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    background-color: @background;
}

mainbox {
    children: [inputbar, message, listview];
    padding: 20px;
    spacing: 15px;
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    spacing: 14px;
    padding: 14px 16px;
    border-radius: 10px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
    background-color: transparent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Buscar aplicaciones, ventanas o comandos…";
    placeholder-color: @muted;
    text-color: @text-strong;
    background-color: transparent;
    expand: true;
    vertical-align: 0.5;
}

message {
    padding: 8px;
    background-color: @surface;
    border-radius: 8px;
}

textbox {
    background-color: transparent;
    text-color: @muted;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: false;
    spacing: 6px;
    background-color: transparent;
}

element {
    children: [element-icon, element-text];
    orientation: horizontal;
    spacing: 14px;
    padding: 11px 14px;
    background-color: transparent;
    border-radius: 9px;
}

element-icon {
    size: 25px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: @text;
    vertical-align: 0.5;
}

element selected {
    background-color: @surface-hover;
}

element selected.normal {
    text-color: @text-strong;
}

element selected.urgent {
    text-color: @urgent;
}

element-text selected {
    text-color: @text-strong;
}

element-text urgent {
    text-color: @urgent;
}
